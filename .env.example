# Firebase Firestore
GOOGLE_CLOUD_PROJECT=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:/full/path/to/firebase-service-account.json
# For local Firestore Emulator only, uncomment and use its host/port.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Local Liggy server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
PYTHON_EXECUTABLE=C:/full/path/to/sdc/.venv/Scripts/python.exe
SESSION_SECRET=replace-with-a-long-random-secret

# Invoice agent (OpenAI-compatible API; model must support vision and tool calling)
APIKEY=your_provider_api_key
AI_URL=https://your-provider-api-base-url/v1
BASEMODEL=your_vision_and_tool_calling_model

# Liggy Help chatbot (may use the same provider/model as the invoice agent)
OPENAI_API_KEY=your_provider_api_key
OPENAI_BASE_URL=https://your-provider-api-base-url/v1
OPENAI_MODEL=your_json-capable_model

# Optional email delivery; leave blank if you do not send invoices by email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
