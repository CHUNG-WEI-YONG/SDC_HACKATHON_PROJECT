PORT=3001
CLIENT_ORIGIN=http://localhost:5173
PYTHON_EXECUTABLE=python
SESSION_SECRET=replace-with-a-long-random-secret-before-deploy
GOOGLE_CLOUD_PROJECT=your-firebase-project-id
# Path to a Firebase service-account JSON file, or omit when using Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/firebase-service-account.json

# Configure these values in server/.env to enable invoice emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
