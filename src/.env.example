# Invoice-agent settings. Replace all three with values from your chosen
# OpenAI-compatible provider. The agent model must support image input and
# function/tool calling for invoice extraction.
APIKEY=replace-with-your-agent-provider-key
AI_URL=https://your-provider.example/v1
BASEMODEL=your-vision-and-function-calling-model

# Liggy AI chatbot settings. These may match the agent settings above, or use
# a different key, endpoint, and model. The chatbot model must support JSON mode.
OPENAI_API_KEY=replace-with-your-chatbot-provider-key
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_MODEL=your-json-capable-chat-model
